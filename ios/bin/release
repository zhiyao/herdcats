#!/usr/bin/env bash
# Prepare a version bump on a PR branch. Tag only the tested, merged commit.
#
# Usage: ./ios/bin/release 0.1.0
set -euo pipefail

VERSION="${1:-}"
if [[ -z "$VERSION" ]]; then
  echo "Usage: $0 <version>  (e.g. $0 0.1.0)"
  exit 1
fi
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: version must look like MAJOR.MINOR.PATCH (got '$VERSION')."
  exit 1
fi

TAG="herdcats-v$VERSION"
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
IOS_DIR="$ROOT/ios"
PROJECT_YML="$IOS_DIR/project.yml"

echo "[herdcats] Releasing $TAG"

if ! git -C "$ROOT" rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "Error: the repository has no commits yet. Make an initial commit first."
  exit 1
fi

if [[ -n "$(git -C "$ROOT" status --porcelain)" ]]; then
  echo "Error: working tree is dirty. Commit or stash changes first."
  exit 1
fi

BRANCH="$(git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null || true)"
if [[ -z "$BRANCH" || "$BRANCH" == "main" ]]; then
  echo "Error: create a release branch before running this command. main requires a PR." >&2
  exit 1
fi

if git -C "$ROOT" rev-parse "$TAG" &>/dev/null \
   || git -C "$ROOT" rev-parse "herdrcat-v$VERSION" &>/dev/null; then
  echo "Error: tag $TAG (or legacy herdrcat-v$VERSION) already exists."
  exit 1
fi

# The public repository starts with fresh history. Commit count alone can be
# lower than builds already uploaded from the private repository.
CURRENT_BUILD="$(sed -n -E 's/^[[:space:]]*CFBundleVersion:[[:space:]]*"([0-9]+)".*/\1/p' "$PROJECT_YML")"
if [[ ! "$CURRENT_BUILD" =~ ^[0-9]+$ ]]; then
  echo "Error: CFBundleVersion must be a quoted integer in project.yml." >&2
  exit 1
fi
BUILD_NUMBER=$(( 10#$CURRENT_BUILD + 1 ))
COMMIT_BUILD=$(( $(git -C "$ROOT" rev-list --count HEAD) + 1 ))
if (( COMMIT_BUILD > BUILD_NUMBER )); then
  BUILD_NUMBER="$COMMIT_BUILD"
fi

echo "Bumping CFBundleShortVersionString to $VERSION (build $BUILD_NUMBER)..."
sed -i.bak -E \
  -e 's/^([[:space:]]*CFBundleShortVersionString:[[:space:]]*")[^"]+(")/\1'"$VERSION"'\2/' \
  -e 's/^([[:space:]]*CFBundleVersion:[[:space:]]*")[^"]+(")/\1'"$BUILD_NUMBER"'\2/' \
  "$PROJECT_YML"
rm "$PROJECT_YML.bak"

if ! grep -qE "CFBundleShortVersionString:[[:space:]]*\"$VERSION\"" "$PROJECT_YML" \
   || ! grep -qE "CFBundleVersion:[[:space:]]*\"$BUILD_NUMBER\"" "$PROJECT_YML"; then
  echo "Error: failed to update version fields in $PROJECT_YML." >&2
  git -C "$ROOT" checkout -- ios/project.yml
  exit 1
fi

echo "Regenerating xcodeproj..."
(cd "$IOS_DIR" && xcodegen generate)

echo "Staging changes..."
git -C "$ROOT" add ios/project.yml
# xcodegen rewrites the project and the generated Info.plist; stage them only
# if they are tracked.
for path in ios/Herdcats.xcodeproj/project.pbxproj ios/Herdcats/Info.plist; do
  if git -C "$ROOT" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
    git -C "$ROOT" add "$path"
  fi
done

echo "Committing release..."
git -C "$ROOT" commit -m "chore(release): $TAG"

echo ""
echo "Prepared $TAG (build $BUILD_NUMBER). Push this branch and open a PR:"
echo "  git push -u origin $BRANCH"
echo "After merge and passing CI, create the release tag at the tested main commit."
echo "See RELEASING.md. No tag was created."
