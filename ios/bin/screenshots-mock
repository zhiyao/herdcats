#!/usr/bin/env python3
"""Capture native SwiftUI screens with read-only fixtures; no SSH server required."""
import argparse
import hashlib
from datetime import datetime, timezone
import json
from pathlib import Path
import subprocess
import time

ROOT = Path(__file__).resolve().parents[2]
IOS = ROOT / 'ios'
BUNDLE = 'com.enchantinglabs.herdrcat'
FRAMES = {
    '01_onboarding': 'onboarding',
    '02_connect_form': 'connect', '03_spaces': 'spaces',
    '04_workspace_pane': 'pane', '05_pane_keys': 'keys',
    '06_agents': 'agents', '07_agent_pane': 'agent-pane',
    '08_quota': 'quota', '09_settings': 'settings',
    '10_compose': 'compose', '11_voice': 'voice',
    '12_timeline': 'timeline',
}

def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--device', default='iPhone 17 Pro Max')
    parser.add_argument('--only', nargs='+', choices=FRAMES, help='Capture selected frames')
    parser.add_argument('--app', type=Path, help='Use an already-built Debug simulator app')
    parser.add_argument('--appearance', choices=['dark', 'light'], default='dark')
    parser.add_argument('--output', type=Path)
    options = parser.parse_args()
    if options.output is None:
        suffix = '-light' if options.appearance == 'light' else ''
        options.output = IOS / f'maestro/screenshots-output/mock-iPhone{suffix}'
    listing = json.loads(subprocess.check_output(['xcrun', 'simctl', 'list', 'devices', 'available', '-j']))
    devices = [d for runtime, group in listing['devices'].items() for d in group if 'iOS' in runtime and (d['udid'] == options.device or d['name'] == options.device)]
    if not devices:
        parser.error('No available iPhone matches --device')
    device = devices[0]
    if not device['name'].startswith('iPhone'):
        parser.error('Choose an iPhone simulator')
    app = options.app
    if app is None:
        build = IOS / 'build/screenshots-derived-data'
        run('xcodegen', 'generate', '--spec', str(IOS / 'project.yml'))
        run('xcodebuild', '-project', str(IOS / 'Herdcats.xcodeproj'), '-scheme', 'Herdcats', '-configuration', 'Debug', '-destination', f"platform=iOS Simulator,id={device['udid']}", '-derivedDataPath', str(build), 'CODE_SIGNING_ALLOWED=NO', 'build')
        app = build / 'Build/Products/Debug-iphonesimulator/Herdcats.app'
    udid = device['udid']
    if device['state'] != 'Booted':
        run('xcrun', 'simctl', 'boot', udid)
    run('xcrun', 'simctl', 'bootstatus', udid, '-b')
    run('xcrun', 'simctl', 'install', udid, str(app))
    run('xcrun', 'simctl', 'ui', udid, 'appearance', options.appearance)
    run('xcrun', 'simctl', 'ui', udid, 'content_size', 'large')
    run('xcrun', 'simctl', 'status_bar', udid, 'override', '--time', '9:41', '--dataNetwork', 'wifi', '--wifiMode', 'active', '--wifiBars', '3', '--batteryState', 'charged', '--batteryLevel', '100')
    options.output.mkdir(parents=True, exist_ok=True)
    manifest = options.output / 'manifest.json'
    previous = json.loads(manifest.read_text()).get('frames', {}) if manifest.exists() and options.only else {}
    manifest.unlink(missing_ok=True)
    try:
        frames = {frame: FRAMES[frame] for frame in options.only} if options.only else FRAMES
        for frame, screen in frames.items():
            (options.output / f'{frame}.png').unlink(missing_ok=True)
            subprocess.run(['xcrun', 'simctl', 'terminate', udid, BUNDLE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if screen == 'onboarding':
                launch = ['-launchPreference', 'connectionSelection',
                          '-hc.onboardingIntroSeen', 'NO', '-appearancePreference', options.appearance]
            else:
                launch = ['-hc.screenshots', '-hc.capture-surface', '-hc.screen', screen,
                          '-hc.tab', screen, '-paneShowComposeByDefault', 'NO',
                          '-appearancePreference', options.appearance]
                if options.appearance == 'light':
                    launch.append('-hc.light')
            run('xcrun', 'simctl', 'launch', udid, BUNDLE, *launch)
            time.sleep(10)
            run('xcrun', 'simctl', 'io', udid, 'screenshot', str(options.output / f'{frame}.png'))
        record = {
            'mode': 'simulator fixtures (onboarding uses real first launch)',
            'createdAt': datetime.now(timezone.utc).isoformat(),
            'commit': subprocess.check_output(
                ['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip(),
            'appearance': options.appearance,
            'device': device['name'], 'udid': udid, 'app': str(app),
            'appSha256': hashlib.sha256((app / 'Herdcats').read_bytes()).hexdigest(),
            'fixtureSha256': hashlib.sha256(
                (IOS / 'Herdcats/Support/ScreenshotFixtures.swift').read_bytes()).hexdigest(),
            'frames': previous | frames,
            'sha256': {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
                       for p in sorted(options.output.glob('*.png'))},
        }
        manifest.write_text(json.dumps(record, indent=2) + '\n')
    finally:
        run('xcrun', 'simctl', 'status_bar', udid, 'clear')
    print(f'Captured {len(frames)} screenshots: {options.output}')

if __name__ == '__main__':
    main()
