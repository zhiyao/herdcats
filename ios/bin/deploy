#!/usr/bin/env bash
# Prepare a release through the protected PR workflow:
#
#   1. next-version - suggest a version
#   2. release      - bump and commit on a PR branch, without tagging
#   3. push         - optionally push the branch for review and CI
#
# After merge, follow RELEASING.md. TestFlight uploads use bin/beta separately.
# Any "n" response or sub-script failure aborts the remaining flow.
#
# Usage: ./ios/bin/deploy
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(git -C "$BIN_DIR" rev-parse --show-toplevel)"
cd "$ROOT"

banner() {
  echo ""
  echo "======================================"
  echo "  $1"
  echo "======================================"
}

abort() {
  echo "Aborted: $1" >&2
  exit 1
}

confirm() {
  local prompt="$1"
  local reply
  read -r -p "$prompt (y/n): " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

banner "herdrcat deploy"

# Fail before any release preparation changes.
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  abort "the repository has no commits yet. Make an initial commit first."
fi
if [[ -n "$(git status --porcelain)" ]]; then
  abort "working tree is dirty. Commit or stash changes first."
fi

BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if [[ -z "$BRANCH" || "$BRANCH" == "main" ]]; then
  abort "create a release branch first. main requires a PR."
fi

# ----- 1. Version ----------------------------------------------------------
banner "Step 1/3: choose version"
NEXT_OUTPUT="$("$BIN_DIR/next-version")"
echo "$NEXT_OUTPUT"
echo ""

SUGGESTED="$(echo "$NEXT_OUTPUT" | sed -n 's/^Suggested next version: //p')"
[[ -n "$SUGGESTED" ]] || abort "could not determine suggested version."

read -r -p "Use $SUGGESTED? (y=use it / type a custom version / n=abort): " VERSION_REPLY
case "$VERSION_REPLY" in
  y|Y) VERSION="$SUGGESTED" ;;
  n|N) abort "user cancelled at version step." ;;
  "")  abort "no version entered." ;;
  *)   VERSION="$VERSION_REPLY" ;;
esac

echo ""
echo "Releasing version: $VERSION"
confirm "Proceed?" || abort "user cancelled."

# ----- 2. Release ----------------------------------------------------------
banner "Step 2/3: prepare release (bump and commit)"
"$BIN_DIR/release" "$VERSION"

# ----- 3. Push PR branch ---------------------------------------------------
banner "Step 3/3: push branch for review"
echo "Release $VERSION is prepared on $BRANCH. No tag or upload was created."
if ! git remote get-url origin >/dev/null 2>&1; then
  echo "No 'origin' remote configured; skipping push."
elif confirm "Push branch to origin for a PR?"; then
  git push -u origin "$BRANCH"
else
  echo "Skipping push. Run later with: git push -u origin $BRANCH"
fi

echo "Open a PR, wait for CI, and merge before preparing a release at the tested commit."
echo "See RELEASING.md. Use bin/beta separately for an authorized TestFlight upload."
